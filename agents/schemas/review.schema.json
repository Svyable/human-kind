{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Svyable/human-kind/agents/schemas/review.schema.json",
  "title": "Human Kind agent review artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "review_id",
    "idea_id",
    "role",
    "reviewer_id",
    "source_issue",
    "created_at",
    "summary",
    "findings",
    "sources",
    "uncertainties",
    "risks",
    "recommended_status",
    "next_action",
    "generated_by",
    "claims_requiring_verification",
    "source_links_required",
    "decision_authority"
  ],
  "anyOf": [
    {"required": ["human_reviewer"]},
    {"required": ["review_requirement", "verification_status"]}
  ],
  "properties": {
    "review_id": {"type": "string", "pattern": "^AR-[0-9]{4,}$"},
    "idea_id": {"type": "string", "pattern": "^HK-[0-9]{4,}$"},
    "role": {"enum": ["scout", "skeptic", "synthesizer", "taxonomist", "pilot-designer", "red-team"]},
    "reviewer_id": {"type": "string", "minLength": 2, "maxLength": 160},
    "source_issue": {"type": "string", "format": "uri"},
    "created_at": {"type": "string", "format": "date"},
    "summary": {"type": "string", "minLength": 20},
    "findings": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}},
    "sources": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}},
    "uncertainties": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}},
    "risks": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}},
    "recommended_status": {"enum": ["intake", "needs-evidence", "needs-scope", "researching", "designed", "pilot-ready", "piloting", "validated", "not-pursuing", "archived"]},
    "next_action": {"type": "string", "minLength": 5},
    "generated_by": {"const": "agent"},
    "human_reviewer": {"const": "required"},
    "review_requirement": {"const": "independent"},
    "verification_status": {"enum": ["unverified", "independently-reviewed", "reproduced", "externally-validated"]},
    "claims_requiring_verification": {"const": true},
    "source_links_required": {"const": true},
    "decision_authority": {"enum": ["none", "repository-scoped"]}
  }
}
