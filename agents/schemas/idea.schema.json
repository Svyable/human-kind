{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Svyable/human-kind/agents/schemas/idea.schema.json",
  "title": "Human Kind idea dossier metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "status", "domains", "geography", "time_horizon", "problem_statement", "beneficiaries", "theory_of_change", "intervention_type", "maturity", "evidence_level", "expected_impact", "cost_band", "reversibility", "key_risks", "equity_considerations", "success_metrics", "next_action", "owners", "sources", "last_reviewed"],
  "properties": {
    "id": {"type": "string", "pattern": "^HK-[0-9]{4,}$"},
    "title": {"type": "string", "minLength": 8, "maxLength": 160},
    "status": {"enum": ["intake", "needs-evidence", "needs-scope", "researching", "designed", "pilot-ready", "piloting", "validated", "not-pursuing", "archived"]},
    "domains": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["climate", "health", "poverty-and-economic-mobility", "conflict-and-governance", "education", "information-integrity", "digital-rights-and-ai-safety", "biodiversity", "disaster-resilience", "cross-cutting"]}},
    "geography": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 2}},
    "time_horizon": {"enum": ["short", "medium", "long"]},
    "problem_statement": {"type": "string", "minLength": 20},
    "beneficiaries": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "theory_of_change": {"type": "string", "minLength": 20},
    "intervention_type": {"type": "array", "minItems": 1, "items": {"enum": ["policy", "technology", "service", "institution", "financing", "research", "education", "infrastructure", "community-practice", "standards"]}},
    "maturity": {"enum": ["concept", "researched", "designed", "pilot-ready", "piloted", "operational"]},
    "evidence_level": {"enum": ["hypothesis", "suggestive", "supported", "strong", "contested"]},
    "expected_impact": {"enum": ["unknown", "low", "medium", "high", "transformative"]},
    "cost_band": {"enum": ["unknown", "low", "medium", "high", "very-high"]},
    "reversibility": {"enum": ["low", "medium", "high"]},
    "key_risks": {"type": "array", "items": {"type": "string"}},
    "equity_considerations": {"type": "string", "minLength": 10},
    "success_metrics": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "next_action": {"type": "string", "minLength": 5},
    "owners": {"type": "array", "items": {"type": "string"}},
    "sources": {"type": "array", "items": {"type": "string"}},
    "last_reviewed": {"type": "string", "format": "date"},
    "generated_by": {"enum": ["agent"]},
    "human_reviewer": {"enum": ["required"]},
    "claims_requiring_verification": {"type": "boolean"},
    "source_links_required": {"type": "boolean"},
    "decision_authority": {"enum": ["none", "repository-scoped"]},
    "source_issue": {"type": "string", "format": "uri"},
    "source_agent": {"type": "string", "minLength": 2, "maxLength": 120}
  }
}
